// metrometre — Cloudflare Workers yapılandırması
// Site "Workers + statik dosyalar" olarak yayınlanıyor. Bu dosya:
//  • reponun kökünü statik site olarak sunar (eskisi gibi),
//  • tanınmayan yollarda 404.html'i 404 durum koduyla döner (eskiden index.html
//    dönüyordu; arama motorları bunu "soft 404" sayıyordu). Harita hash ile
//    yönlendirdiği için SPA geri dönüşüne ihtiyacı yoktur,
//  • yalnızca /hat/*, /hat-sayfalari/* ve /feed.xml isteklerinde worker/index.js'i
//    çalıştırır (hat sayfaları, kanonik yönlendirme, RSS); ayrıca /google* için
//    Search Console doğrulama dosyasını yönlendirmesiz sunar.
// "name", Cloudflare panelindeki Worker adıyla aynı olmalıdır.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "metrometre-data",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-21",
  "observability": { "enabled": true },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/hat", "/hat/*", "/hat-sayfalari/*", "/feed.xml", "/google*"]
  }
}
